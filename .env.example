# Local development only. Do not reuse these credentials in another environment.
# Compose uses fixed disposable PostgreSQL credentials for local development.
DATABASE_URL=postgresql://fai:fai@postgres:5432/fai_control_plane

WEB_PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# Export telemetry to a local collector when one is available.
OTEL_SERVICE_NAMESPACE=fai-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integrations are opt-in. Secret values belong in mounted files or an external
# secret provider, never in PostgreSQL. The database stores only secret refs.
GITHUB_SYNC_ENABLED=false
GITHUB_INGRESS_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET_HOST_FILE=./infra/compose/secrets/github-webhook.disabled
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook
FCP_WORKSPACE_ID=
GITHUB_MSA_PROJECT_ID=
GITHUB_MSA_INSTALLATION_ID=
GITHUB_ASCON_PROJECT_ID=
GITHUB_ASCON_INSTALLATION_ID=

# Runner execution is disabled in the default local stack. Artifacts written by
# worker-owned orchestration use the mounted path below.
RUNNER_ENABLED=false
RUNNER_NETWORK_MODE=none
ARTIFACTS_ROOT=/var/lib/fai/artifacts

# Authentication secrets must be supplied as mounted files when auth is enabled.
AUTH_ENABLED=false
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET_FILE=
AUTH_SESSION_SECRET_FILE=

# Read-only shares remain disabled unless explicitly enabled and configured.
PUBLIC_SHARING_ENABLED=false
SHARE_SIGNING_KEY_FILE=
