# Local MVP only. Secret values stay in absolute host-owned files.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD_FILE=
DATABASE_URL=
WEB_PORT=3000
WORKER_PORT=3001
FCP_WORKSPACE_ID=
FCP_WORKER_ACTIVE=false
BOOTSTRAP_WORKSPACE_SLUG=
BOOTSTRAP_WORKSPACE_NAME=
BOOTSTRAP_OWNER_ACTOR_ID=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_GITHUB_USER_ID=
BOOTSTRAP_OWNER_TELEGRAM_USER_ID=
BOOTSTRAP_TRACKER_SECRET_REF_ID=

AUTH_PUBLIC_BASE_URL=http://localhost:3000/
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET_FILE=/run/secrets/github-login-client-secret
GITHUB_LOGIN_CLIENT_SECRET_HOST_FILE=

GITHUB_PROJECTS_TOKEN_FILE=/run/secrets/github-projects-token
GITHUB_PROJECTS_TOKEN_HOST_FILE=
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook-secret
GITHUB_WEBHOOK_SECRET_HOST_FILE=

BITRIX24_TASK_ID=154312
# Client-originated Bitrix actions stay denied unless this exact value is set after explicit approval.
BITRIX24_CLIENT_ACTIONS_ENABLED=false
