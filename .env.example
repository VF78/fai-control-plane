# Local development only. Do not reuse these credentials in another environment.
# Compose uses fixed disposable PostgreSQL credentials for local development.
DATABASE_URL=postgresql://fai:fai@postgres:5432/fai_control_plane

WEB_PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# Export telemetry to a local collector when one is available.
OTEL_SERVICE_NAMESPACE=fai-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integrations are opt-in. Secret values belong in mounted files or an external
# secret provider, never in PostgreSQL. The database stores only secret refs.
GITHUB_SYNC_ENABLED=false
GITHUB_INGRESS_ENABLED=false
GITHUB_STATUS_WRITEBACK_ENABLED=false
GITHUB_PROJECTS_OAUTH_TOKEN_HOST_FILE=./infra/compose/secrets/github-projects-oauth-token.disabled
GITHUB_PROJECTS_OAUTH_TOKEN_FILE=/run/secrets/github-projects-oauth-token
GITHUB_APP_ID=4397394
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key
GITHUB_APP_PRIVATE_KEY_HOST_FILE=./infra/compose/secrets/github-app-private-key.disabled
GITHUB_WEBHOOK_SECRET_HOST_FILE=./infra/compose/secrets/github-webhook.disabled
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github-webhook
FCP_WORKSPACE_ID=
FCP_OPERATOR_GITHUB_USER_IDS=
FCP_BOOTSTRAP_HUMAN_SUBJECT=
GITHUB_MSA_PROJECT_ID=
GITHUB_MSA_INSTALLATION_ID=149112973
GITHUB_ASCON_PROJECT_ID=
GITHUB_ASCON_INSTALLATION_ID=149112973

# Telegram status replies remain disabled until Vladimir explicitly approves the
# exact response template and its policy. Webhook and stable identity secrets are separate.
TELEGRAM_INGRESS_ENABLED=false
TELEGRAM_STATUS_RESPONSE_ENABLED=false
TELEGRAM_WEBHOOK_SECRET_HOST_FILE=./infra/compose/secrets/telegram-webhook.disabled
TELEGRAM_WEBHOOK_SECRET_FILE=/run/secrets/telegram-webhook
TELEGRAM_IDENTITY_SECRET_HOST_FILE=./infra/compose/secrets/telegram-identity.disabled
TELEGRAM_IDENTITY_SECRET_FILE=/run/secrets/telegram-identity
TELEGRAM_BOT_TOKEN_HOST_FILE=./infra/compose/secrets/telegram-bot-token.disabled
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
TELEGRAM_MSA_PROJECT_ID=
TELEGRAM_ASCON_PROJECT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_PRIVATE_CHAT_IDS=

# Runner execution is disabled in the default local stack. Artifacts written by
# worker-owned orchestration use the mounted path below.
RUNNER_ENABLED=false
HERMES_RUNNER_ENABLED=false
RUNNER_NETWORK_MODE=none
ARTIFACTS_ROOT=/var/lib/fai/artifacts

# The workstation claim transport is a separate, machine-authenticated
# checkpoint. Keep it disabled until every authorization field and the mounted
# token file are configured.
LOCAL_RUNNER_TRANSPORT_ENABLED=false
LOCAL_RUNNER_WORKSPACE_ID=
LOCAL_RUNNER_ID=
LOCAL_RUNNER_ALLOWED_PROJECT_IDS=
LOCAL_RUNNER_ALLOWED_REPOSITORIES=
LOCAL_RUNNER_ALLOWED_RUNTIME_IDS=
LOCAL_RUNNER_TOKEN_HOST_FILE=./infra/compose/secrets/local-runner-token.disabled
LOCAL_RUNNER_TOKEN_FILE=/run/secrets/local-runner-token

# Repository-host publication runs only in the separately operated workstation
# runner. This switch is independent and disabled by default. The token setting
# is an opaque file reference; never place the token value here.
LOCAL_WORKSTATION_REPOSITORY_PUBLISH_ENABLED=false
LOCAL_WORKSTATION_REPOSITORY_PUBLISH_ALLOWED_REPOSITORY=
LOCAL_WORKSTATION_REPOSITORY_PUBLISH_BASE_REF=
LOCAL_WORKSTATION_REPOSITORY_PUBLISH_REQUIRED_CHECKS=
LOCAL_WORKSTATION_REPOSITORY_PUBLISH_TOKEN_FILE=

# GitHub login is separate from GitHub App tracker credentials. It is disabled
# by default. Enabling it requires exactly two immutable numeric user IDs and
# matching human Actors with external subjects `github:user:<id>`.
AUTH_ENABLED=false
AUTH_PUBLIC_BASE_URL=
GITHUB_LOGIN_CALLBACK_URL=
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET_HOST_FILE=./infra/compose/secrets/github-login-client-secret.disabled
GITHUB_LOGIN_CLIENT_SECRET_FILE=/run/secrets/github-login-client-secret
AUTH_SESSION_SECRET_HOST_FILE=./infra/compose/secrets/auth-session-secret.disabled
AUTH_SESSION_SECRET_FILE=/run/secrets/auth-session-secret

# Read-only shares remain disabled unless explicitly enabled and configured.
PUBLIC_SHARING_ENABLED=false
SHARE_SIGNING_KEY_FILE=
