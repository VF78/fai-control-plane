{
  "name": "@fai-control-plane/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @fai-control-plane/db build && pnpm --filter @fai-control-plane/integrations build",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --sourcemap --external pg --external drizzle-orm --external @fai-control-plane/domain --external @fai-control-plane/application --external @fai-control-plane/integrations --external @fai-control-plane/db",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fai-control-plane/application": "workspace:*",
    "@fai-control-plane/db": "workspace:*",
    "@fai-control-plane/domain": "workspace:*",
    "@fai-control-plane/integrations": "workspace:*"
  }
}
