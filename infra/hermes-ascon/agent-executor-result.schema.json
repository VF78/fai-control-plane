{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "fai.agent-executor-result.v1"},
    "decision": {"type": "string", "enum": ["accepted", "rejected"]},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskClass": {"type": "string", "enum": ["manager_project_ops", "ordinary_implementation", "ui_responsive", "complex_implementation", "qa_audit", "architecture_design", "critical_decision", "release_preflight", "protected_operation"]},
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "cli"},
            "id": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "required": ["kind", "id"]
        },
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "effort": {"type": "string", "enum": ["medium", "high"]}
      },
      "required": ["taskClass", "executor", "model", "effort"]
    },
    "outcome": {"type": "string", "enum": ["success", "rework"]},
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemId": {"type": "string", "minLength": 1, "maxLength": 512},
        "fromVersion": {"type": "string", "minLength": 1, "maxLength": 512},
        "targetStage": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "required": ["itemId", "fromVersion", "targetStage"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 100},
          "result": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "required": ["kind", "result"]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 200},
          "url": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "required": ["label", "url"]
      },
      "maxItems": 10
    }
  },
  "required": ["contract", "decision", "execution", "outcome", "transition", "reason", "evidence", "deliverables"]
}
