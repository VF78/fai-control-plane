# Non-secret deployment inputs. Install at /etc/fai-hermes-ascon/production.env
# as root:root mode 0600 and replace every REQUIRED_* value.
HERMES_IMAGE=fai-hermes-ascon:codex-0.144.1
HERMES_MODEL=gpt-5.6-terra
HERMES_RENDERED_CONFIG_FILE=/var/lib/fai-hermes-ascon/runtime-config.yaml
HERMES_API_SECRET_ENV_FILE=/etc/fai-hermes-ascon/secrets/api-server.env
HERMES_TELEGRAM_SECRET_ENV_FILE=/etc/fai-hermes-ascon/secrets/telegram.env
HERMES_TELEGRAM_ALLOWED_USERS=96211907,355724486
HERMES_TELEGRAM_CHAT_ID=-5540760630
FCP_CONVERSATION_ACTION_URL=https://app.f-ai.studio/api/hermes/conversation-actions
HERMES_INTERNAL_BRIDGE_TOKEN_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/internal-bridge-token
HERMES_GITHUB_REPOSITORY_TOKEN_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/github-repository-token
HERMES_DASHBOARD_USERNAME_HOST_FILE=/etc/fai-hermes-ascon/secrets/dashboard-username
HERMES_DASHBOARD_PASSWORD_HOST_FILE=/etc/fai-hermes-ascon/secrets/dashboard-password
HERMES_DASHBOARD_SIGNING_SECRET_HOST_FILE=/etc/fai-hermes-ascon/secrets/dashboard-signing-secret
HERMES_DASHBOARD_USERNAME_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/dashboard-username
HERMES_DASHBOARD_PASSWORD_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/dashboard-password
HERMES_DASHBOARD_SIGNING_SECRET_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/dashboard-signing-secret
HERMES_DEVOPS_SSH_HOST=46.225.163.123
HERMES_DEVOPS_SSH_USER=root
HERMES_DEVOPS_SSH_PORT=22
HERMES_DEVOPS_SSH_IDENTITY_HOST_FILE=/etc/fai-hermes-ascon/secrets/devops-ssh-identity
HERMES_DEVOPS_SSH_KNOWN_HOSTS_HOST_FILE=/etc/fai-hermes-ascon/secrets/devops-ssh-known-hosts
HERMES_DEVOPS_YC_CONFIG_HOST_FILE=/etc/fai-hermes-ascon/secrets/yandex-cloud-config.yaml
HERMES_DEVOPS_SSH_IDENTITY_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/devops-ssh-identity
HERMES_DEVOPS_SSH_KNOWN_HOSTS_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/devops-ssh-known-hosts
HERMES_DEVOPS_YC_CONFIG_FILE=/var/lib/fai-hermes-ascon/runtime-secrets/yandex-cloud-config.yaml
