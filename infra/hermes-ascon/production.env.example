# Non-secret deployment inputs. Install at /etc/fai-hermes-ascon/production.env
# as root:root mode 0600 and replace every REQUIRED_* value.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.7.7.2@sha256:9c841866021c54c4596849f6135717e8a4d52ba510b7f52c50aef1de1a283973
HERMES_PROVIDER=REQUIRED_APPROVED_PROVIDER
HERMES_MODEL=REQUIRED_APPROVED_MODEL
HERMES_API_SECRET_ENV_FILE=/etc/fai-hermes-ascon/secrets/api-server.env
HERMES_PROVIDER_SECRET_ENV_FILE=/etc/fai-hermes-ascon/secrets/provider.env

