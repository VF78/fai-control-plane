NODE_ENV=production
HOST=127.0.0.1
PORT=13010
SERVE_UI=true
PAPERCLIP_HOME=/var/lib/paperclip
PAPERCLIP_CONFIG=/var/lib/paperclip/instances/default/config.json
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_PUBLIC_URL=https://app.f-ai.studio
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://app.f-ai.studio
PAPERCLIP_ALLOWED_HOSTNAMES=app.f-ai.studio
PAPERCLIP_AUTH_DISABLE_SIGN_UP=true
PAPERCLIP_SECRETS_STRICT_MODE=true
PAPERCLIP_STORAGE_PROVIDER=local_disk
PAPERCLIP_STORAGE_LOCAL_DIR=/var/lib/paperclip/storage
PAPERCLIP_DB_BACKUP_ENABLED=false
DATABASE_URL=postgresql://paperclip:REPLACE_HOST_OWNED_PASSWORD@127.0.0.1:15432/paperclip
BETTER_AUTH_SECRET=REPLACE_HOST_OWNED_RANDOM_SECRET
PAPERCLIP_AGENT_JWT_SECRET=REPLACE_HOST_OWNED_RANDOM_SECRET
