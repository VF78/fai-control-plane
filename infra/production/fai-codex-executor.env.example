FAI_EXECUTOR_SOCKET=/run/fai-hermes-executor/executor.sock
FAI_EXECUTOR_NODE=/usr/bin/node
FAI_EXECUTOR_BUNDLE=/opt/fai-control-plane-runner/releases/REPLACE_WITH_RELEASE_COMMIT/packages/runners/dist/hermes-executor-cli.js
FAI_EXECUTOR_BUNDLE_SHA256=REPLACE_WITH_RELEASE_BUNDLE_SHA256
FAI_CONTROLLER_UID=REPLACE_WITH_FAI_HERMES_CONTROLLER_UID
FAI_EXECUTOR_CODEX_HOME=/var/lib/fai-codex-executor/codex-home
FAI_EXECUTOR_REPOSITORY_ROOT=/var/lib/fai-codex-executor/repository
FAI_EXECUTOR_WORKTREE_ROOT=/var/lib/fai-codex-executor/worktrees
FAI_EXECUTOR_ARTIFACT_ROOT=/var/lib/fai-codex-executor/artifacts
FAI_EXECUTOR_EXPECTED_HERMES_CONFIG_SHA256=REPLACE_WITH_SHA256
