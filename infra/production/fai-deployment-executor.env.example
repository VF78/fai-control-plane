# Disabled and impossible to activate without an explicit host-side adapter composition.
FAI_DEPLOYMENT_EXECUTOR_ENABLED=false
FAI_DEPLOYMENT_EXECUTOR_DRY_RUN=true
FAI_DEPLOYMENT_EXECUTOR_CONFIRM_ACTIVATION=REPLACE_WITH_EXPLICIT_CONFIRMATION
FAI_DEPLOYMENT_EXECUTOR_ADAPTER=unavailable
# No server is composed by default. Activation requires a separately authorized
# root:fai-deployment-transport 0770 directory and
# API-UID:fai-deployment-transport 0660 AF_UNIX server socket. Resolve the
# dedicated numeric UID/GID on the host; zero and implicit/default identities fail closed.
FAI_DEPLOYMENT_EXECUTOR_SOCKET_PATH=/run/fai-deployment-api/control.sock
FAI_DEPLOYMENT_EXECUTOR_SOCKET_UID=REPLACE_WITH_DEPLOYMENT_API_UID
FAI_DEPLOYMENT_EXECUTOR_SOCKET_GID=REPLACE_WITH_FAI_DEPLOYMENT_TRANSPORT_GID
FAI_DEPLOYMENT_EXECUTOR_TRANSPORT_GID=REPLACE_WITH_FAI_DEPLOYMENT_TRANSPORT_GID
FAI_DEPLOYMENT_EXECUTOR_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
FAI_DEPLOYMENT_EXECUTOR_ID=REPLACE_WITH_EXECUTOR_ID
FAI_DEPLOYMENT_EXECUTOR_REGISTRATION_ID=REPLACE_WITH_REGISTRATION_UUID
FAI_DEPLOYMENT_EXECUTOR_PROJECT_ID=REPLACE_WITH_PROJECT_UUID
FAI_DEPLOYMENT_EXECUTOR_ENVIRONMENT=production
FAI_DEPLOYMENT_EXECUTOR_TOKEN_FILE=/var/lib/fai-deployment-executor/credentials/claim-token
# Both roots must be canonical, owned by fai-deployment-executor's exact UID/GID,
# and mode 0700; release package files must be regular owner-only mode 0600.
# The staging filesystem must support Linux O_TMPFILE and /proc/self/fd reopening;
# no named-file or pathname-consuming fallback is available.
FAI_DEPLOYMENT_EXECUTOR_ARTIFACT_ROOT=/var/lib/fai-deployment-executor/release-packages
FAI_DEPLOYMENT_EXECUTOR_STAGING_ROOT=/var/lib/fai-deployment-executor/staging
FAI_DEPLOYMENT_EXECUTOR_POLL_INTERVAL_MS=15000
PATH=/usr/bin:/bin
