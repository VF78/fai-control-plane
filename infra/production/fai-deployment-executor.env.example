# Disabled and impossible to activate without an explicit host-side adapter composition.
FAI_DEPLOYMENT_EXECUTOR_ENABLED=false
FAI_DEPLOYMENT_EXECUTOR_DRY_RUN=true
FAI_DEPLOYMENT_EXECUTOR_CONFIRM_ACTIVATION=REPLACE_WITH_EXPLICIT_CONFIRMATION
FAI_DEPLOYMENT_EXECUTOR_ADAPTER=unavailable
FAI_DEPLOYMENT_EXECUTOR_BASE_URL=http://127.0.0.1:13000
FAI_DEPLOYMENT_EXECUTOR_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
FAI_DEPLOYMENT_EXECUTOR_ID=REPLACE_WITH_EXECUTOR_ID
FAI_DEPLOYMENT_EXECUTOR_REGISTRATION_ID=REPLACE_WITH_REGISTRATION_UUID
FAI_DEPLOYMENT_EXECUTOR_PROJECT_ID=REPLACE_WITH_PROJECT_UUID
FAI_DEPLOYMENT_EXECUTOR_ENVIRONMENT=production
FAI_DEPLOYMENT_EXECUTOR_TOKEN_FILE=/var/lib/fai-deployment-executor/credentials/claim-token
FAI_DEPLOYMENT_EXECUTOR_ARTIFACT_ROOT=/var/lib/fai-deployment-executor/release-packages
FAI_DEPLOYMENT_EXECUTOR_POLL_INTERVAL_MS=15000
PATH=/usr/bin:/bin
