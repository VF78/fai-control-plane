FAI_HERMES_RUNNER_ENABLED=true
FAI_HERMES_RUNNER_BASE_URL=http://127.0.0.1:13000
FAI_HERMES_RUNNER_ID=REPLACE_WITH_RUNNER_ID
FAI_HERMES_RUNNER_REGISTRATION_ID=REPLACE_WITH_REGISTRATION_UUID
FAI_HERMES_RUNNER_REPOSITORY=REPLACE_WITH_OWNER_REPOSITORY
FAI_HERMES_RUNNER_CLAIM_TOKEN_FILE=/var/lib/fai-hermes-controller/credentials/claim-token
FAI_HERMES_RUNNER_OBSERVATION_TOKEN_FILE=/var/lib/fai-hermes-controller/credentials/observation-token
FAI_HERMES_RUNNER_OBSERVATION_TTL_SECONDS=120
FAI_HERMES_RUNNER_POLL_INTERVAL_MS=15000
FAI_HERMES_RUNNER_PYTHON=/opt/fai-control-plane-runner/hermes-runtime/0.18.2/venv/bin/python
FAI_HERMES_RUNNER_ENTRYPOINT=/opt/fai-control-plane-runner/releases/REPLACE_WITH_RELEASE_COMMIT/packages/runners/runtime/hermes_no_tools_orchestrator.py
FAI_HERMES_RUNNER_HERMES_HOME=/var/lib/fai-hermes-controller/hermes
FAI_HERMES_RUNNER_CONFIG_FILE=/var/lib/fai-hermes-controller/hermes/config.yaml
FAI_HERMES_RUNNER_CONFIG_SHA256=REPLACE_WITH_SHA256
FAI_HERMES_EXECUTOR_SOCKET=/run/fai-hermes-executor/executor.sock
PATH=/usr/bin:/bin
