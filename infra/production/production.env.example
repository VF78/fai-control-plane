# Copy to an operator-owned file outside the checkout, such as
# /etc/fai-control-plane/production.env. This file contains non-secret runtime
# configuration and host paths only. Replace every REPLACE_* value.
FCP_IMAGE_TAG=REPLACE_WITH_RELEASE_COMMIT
POSTGRES_IMAGE=postgres:16-bookworm@sha256:REPLACE_WITH_APPROVED_IMAGE_DIGEST
WEB_BIND_PORT=13000
POSTGRES_DB=fai_control_plane
POSTGRES_USER=fai

LOG_LEVEL=info
OTEL_SERVICE_NAMESPACE=fai-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

GITHUB_SYNC_ENABLED=false
GITHUB_INGRESS_ENABLED=false
GITHUB_STATUS_WRITEBACK_ENABLED=false
GITHUB_APP_ID=4397394
FCP_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
FCP_OPERATOR_GITHUB_USER_IDS=REPLACE_WITH_TWO_COMMA_SEPARATED_GITHUB_USER_IDS
FCP_BOOTSTRAP_HUMAN_SUBJECT=github:user:REPLACE_WITH_BOOTSTRAP_GITHUB_USER_ID
GITHUB_MSA_PROJECT_ID=REPLACE_WITH_MSA_PROJECT_ID
GITHUB_MSA_INSTALLATION_ID=149112973
GITHUB_ASCON_PROJECT_ID=REPLACE_WITH_ASCON_PROJECT_ID
GITHUB_ASCON_INSTALLATION_ID=149112973

TELEGRAM_INGRESS_ENABLED=false
TELEGRAM_STATUS_RESPONSE_ENABLED=false
TELEGRAM_PROJECT_ID=REPLACE_WITH_TELEGRAM_PROJECT_ID
TELEGRAM_ALLOWED_USER_IDS=REPLACE_WITH_ALLOWED_USER_IDS
TELEGRAM_ALLOWED_PRIVATE_CHAT_IDS=REPLACE_WITH_ALLOWED_PRIVATE_CHAT_IDS

RUNNER_ENABLED=false
RUNNER_NETWORK_MODE=none
LOCAL_RUNNER_TRANSPORT_ENABLED=false
LOCAL_RUNNER_WORKSPACE_ID=REPLACE_WITH_RUNNER_WORKSPACE_UUID
LOCAL_RUNNER_ID=REPLACE_WITH_RUNNER_ID
LOCAL_RUNNER_ALLOWED_PROJECT_IDS=REPLACE_WITH_ALLOWED_PROJECT_IDS
LOCAL_RUNNER_ALLOWED_REPOSITORIES=REPLACE_WITH_ALLOWED_OWNER_REPOSITORIES
LOCAL_RUNNER_ALLOWED_RUNTIME_IDS=REPLACE_WITH_ALLOWED_RUNTIME_IDS

AUTH_ENABLED=true
AUTH_PUBLIC_BASE_URL=https://app.f-ai.studio
GITHUB_LOGIN_CALLBACK_URL=https://app.f-ai.studio/api/auth/github/callback
GITHUB_LOGIN_CLIENT_ID=Ov23li6xIseHRQCF38Fz
PUBLIC_SHARING_ENABLED=false

POSTGRES_PASSWORD_HOST_FILE=/etc/fai-control-plane/secrets/postgres-password
DATABASE_URL_HOST_FILE=/etc/fai-control-plane/secrets/database-url
GITHUB_PROJECTS_OAUTH_TOKEN_HOST_FILE=/etc/fai-control-plane/secrets/github-projects-oauth-token
GITHUB_APP_PRIVATE_KEY_HOST_FILE=/etc/fai-control-plane/secrets/github-app-private-key
GITHUB_WEBHOOK_SECRET_HOST_FILE=/etc/fai-control-plane/secrets/github-webhook
TELEGRAM_WEBHOOK_SECRET_HOST_FILE=/etc/fai-control-plane/secrets/telegram-webhook
TELEGRAM_IDENTITY_SECRET_HOST_FILE=/etc/fai-control-plane/secrets/telegram-identity
TELEGRAM_BOT_TOKEN_HOST_FILE=/etc/fai-control-plane/secrets/telegram-bot-token
GITHUB_LOGIN_CLIENT_SECRET_HOST_FILE=/etc/fai-control-plane/secrets/github-login-client-secret
AUTH_SESSION_SECRET_HOST_FILE=/etc/fai-control-plane/secrets/auth-session-secret
LOCAL_RUNNER_TOKEN_HOST_FILE=/etc/fai-control-plane/secrets/local-runner-token
SHARE_SIGNING_KEY_HOST_FILE=/etc/fai-control-plane/secrets/share-signing-key
