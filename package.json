{
  "name": "fai-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fai-control-plane/web --filter @fai-control-plane/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @fai-control-plane/db db:generate",
    "db:migrate": "pnpm --filter @fai-control-plane/db db:migrate",
    "github:bootstrap": "tsx apps/web/src/github-bootstrap.ts",
    "db:check": "pnpm --filter @fai-control-plane/db db:check"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "tsup": "8.5.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
