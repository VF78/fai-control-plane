{
  "name": "@fai-control-plane/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name foundation",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "drizzle-kit check",
    "test:schema": "vitest run --root ../.. packages/db/src/schema.test.ts",
    "test:integration": "vitest run --root ../.. packages/db/src/persistence.integration.test.ts packages/db/src/incoming-event-inbox.integration.test.ts packages/db/src/tracker-snapshot-projection.integration.test.ts"
  },
  "dependencies": {
    "@fai-control-plane/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "pg-boss": "12.26.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
