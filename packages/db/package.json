{
  "name": "@fai-control-plane/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/mvp/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/mvp/index.ts src/mvp/migrate.ts src/mvp/bootstrap.ts --format esm --dts --external pg --external drizzle-orm --external @fai-control-plane/domain --external @fai-control-plane/application",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/mvp/migrate.ts",
    "db:bootstrap": "tsx src/mvp/bootstrap.ts",
    "db:check": "vitest run --root ../.. packages/db/src/mvp/schema.test.ts",
    "test": "vitest run --root ../.. packages/db/src/mvp"
  },
  "dependencies": {
    "@fai-control-plane/application": "workspace:*",
    "@fai-control-plane/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  }
}
