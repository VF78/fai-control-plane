{
  "name": "@fai-control-plane/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name foundation",
    "db:migrate": "tsx src/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
