{
  "name": "@fai-control-plane/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/mvp/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/mvp/index.ts src/repository-broker-cli.ts --format esm --dts --external @fai-control-plane/domain --external @fai-control-plane/application",
    "test": "vitest run --root ../.. packages/integrations/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fai-control-plane/application": "workspace:*",
    "@fai-control-plane/domain": "workspace:*"
  }
}
